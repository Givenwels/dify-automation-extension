{
  "manifest_version": 3,
  "name": "Dify 自动化",
  "version": "1.4.2",
  "description": "对话式 AI 工作流工程师：描述需求，自动在 Dify 上创建、修改、测试工作流",
  "permissions": ["storage", "sidePanel", "tabs", "scripting", "cookies"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "打开 Dify 自动化",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": { "default_path": "sidepanel.html" }
}
